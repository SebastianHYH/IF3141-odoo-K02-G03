<odoo>
    <record id="module_category_ipfarm" model="ir.module.category">
        <field name="name">IP FarmBook</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_ipfarm_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" eval="False"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_ipfarm_production" model="res.groups">
        <field name="name">Divisi Produksi/Growing</field>
        <field name="category_id" ref="module_category_ipfarm"/>
        <field name="implied_ids" eval="[(4, ref('group_ipfarm_user'))]"/>
    </record>

    <record id="group_ipfarm_seedling" model="res.groups">
        <field name="name">Divisi Pembibitan</field>
        <field name="category_id" ref="module_category_ipfarm"/>
        <field name="implied_ids" eval="[(4, ref('group_ipfarm_user'))]"/>
    </record>

    <record id="group_ipfarm_processing" model="res.groups">
        <field name="name">Divisi Processing</field>
        <field name="category_id" ref="module_category_ipfarm"/>
        <field name="implied_ids" eval="[(4, ref('group_ipfarm_user'))]"/>
    </record>

    <record id="group_ipfarm_finance" model="res.groups">
        <field name="name">Divisi Finance</field>
        <field name="category_id" ref="module_category_ipfarm"/>
        <field name="implied_ids" eval="[(4, ref('group_ipfarm_user'))]"/>
    </record>

    <record id="group_ipfarm_management" model="res.groups">
        <field name="name">Management</field>
        <field name="category_id" ref="module_category_ipfarm"/>
        <field name="implied_ids" eval="[(4, ref('group_ipfarm_user'))]"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[(4, ref('group_ipfarm_management'))]"/>
    </record>
</odoo>
