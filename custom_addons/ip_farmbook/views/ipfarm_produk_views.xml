<odoo>
    <record id="view_ipfarm_produk_tree" model="ir.ui.view">
        <field name="name">ipfarm.produk.tree</field>
        <field name="model">ipfarm.produk</field>
        <field name="arch" type="xml">
            <tree string="Ketersediaan Stok Produk" create="0">
                <field name="kode"/>
                <field name="name"/>
                <field name="kategori"/>
                <field name="stok_tersedia" sum="Total Stok Saat Ini"/>
                <field name="uom_id"/>
                <field name="total_stok_masuk_panen" sum="Total Masuk Panen"/>
                <field name="total_stok_keluar_pemrosesan" sum="Total Keluar Pemrosesan"/>
                <field name="last_stock_update"/>
                <field name="status_stok" widget="badge" decoration-danger="status_stok == 'habis'" decoration-warning="status_stok == 'rendah'" decoration-success="status_stok == 'aman'"/>
            </tree>
        </field>
    </record>

    <record id="view_ipfarm_produk_form" model="ir.ui.view">
        <field name="name">ipfarm.produk.form</field>
        <field name="model">ipfarm.produk</field>
        <field name="arch" type="xml">
            <form string="Produk">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="kode"/>
                            <field name="kategori"/>
                            <field name="uom_id"/>
                        </group>
                        <group>
                            <field name="stok_tersedia" readonly="1"/>
                            <field name="minimum_stok"/>
                            <field name="status_stok" widget="badge" readonly="1" decoration-danger="status_stok == 'habis'" decoration-warning="status_stok == 'rendah'" decoration-success="status_stok == 'aman'"/>
                            <field name="last_stock_update" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ringkasan Stok">
                            <group>
                                <field name="total_stok_masuk_panen" readonly="1"/>
                                <field name="total_stok_keluar_pemrosesan" readonly="1"/>
                            </group>
                        </page>
                        <page string="Riwayat Perubahan Stok">
                            <field name="histori_ids" readonly="1">
                                <tree string="Riwayat Stok" create="0" edit="0" delete="0">
                                    <field name="tanggal"/>
                                    <field name="jenis_kegiatan"/>
                                    <field name="arah"/>
                                    <field name="jumlah_masuk" sum="Total Masuk"/>
                                    <field name="jumlah_keluar" sum="Total Keluar"/>
                                    <field name="uom_id"/>
                                    <field name="panen_id"/>
                                    <field name="pemrosesan_id"/>
                                    <field name="pegawai_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Hasil Panen">
                            <field name="panen_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="tanggal_panen"/>
                                    <field name="name"/>
                                    <field name="batch_id"/>
                                    <field name="jumlah"/>
                                    <field name="uom_id"/>
                                    <field name="pegawai_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Pemrosesan">
                            <field name="pemrosesan_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="tanggal_pemrosesan"/>
                                    <field name="name"/>
                                    <field name="jumlah"/>
                                    <field name="uom_id"/>
                                    <field name="pegawai_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ipfarm_produk_search" model="ir.ui.view">
        <field name="name">ipfarm.produk.search</field>
        <field name="model">ipfarm.produk</field>
        <field name="arch" type="xml">
            <search string="Cari Produk">
                <field name="name"/>
                <field name="kode"/>
                <field name="kategori"/>
                <field name="status_stok"/>
                <field name="last_stock_update"/>
                <filter name="stok_aman" string="Stok Aman" domain="[('status_stok', '=', 'aman')]"/>
                <filter name="stok_rendah" string="Stok Rendah" domain="[('status_stok', '=', 'rendah')]"/>
                <filter name="stok_habis" string="Stok Habis" domain="[('status_stok', '=', 'habis')]"/>
                <separator/>
                <filter name="group_kategori" string="Kategori" context="{'group_by': 'kategori'}"/>
                <filter name="group_status" string="Status Stok" context="{'group_by': 'status_stok'}"/>
                <filter name="group_last_update" string="Tanggal Pembaruan" context="{'group_by': 'last_stock_update'}"/>
            </search>
        </field>
    </record>

    <record id="view_ipfarm_produk_graph" model="ir.ui.view">
        <field name="name">ipfarm.produk.graph</field>
        <field name="model">ipfarm.produk</field>
        <field name="arch" type="xml">
            <graph string="Analisis Stok Produk" type="bar">
                <field name="kategori"/>
                <field name="stok_tersedia" type="measure"/>
                <field name="total_stok_masuk_panen" type="measure"/>
                <field name="total_stok_keluar_pemrosesan" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_ipfarm_produk_pivot" model="ir.ui.view">
        <field name="name">ipfarm.produk.pivot</field>
        <field name="model">ipfarm.produk</field>
        <field name="arch" type="xml">
            <pivot string="Pivot Stok Produk">
                <field name="kategori" type="row"/>
                <field name="status_stok" type="col"/>
                <field name="stok_tersedia" type="measure"/>
                <field name="total_stok_masuk_panen" type="measure"/>
                <field name="total_stok_keluar_pemrosesan" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_ipfarm_produk" model="ir.actions.act_window">
        <field name="name">Produk</field>
        <field name="res_model">ipfarm.produk</field>
        <field name="view_mode">tree,form,graph,pivot</field>
        <field name="search_view_id" ref="view_ipfarm_produk_search"/>
    </record>

    <record id="action_ipfarm_ketersediaan_stok" model="ir.actions.act_window">
        <field name="name">Ketersediaan Stok Produk</field>
        <field name="res_model">ipfarm.produk</field>
        <field name="view_mode">tree,form,graph,pivot</field>
        <field name="search_view_id" ref="view_ipfarm_produk_search"/>
        <field name="context">{'search_default_group_status': 1}</field>
    </record>
</odoo>
