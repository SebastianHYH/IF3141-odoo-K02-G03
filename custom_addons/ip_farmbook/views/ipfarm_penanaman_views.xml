<odoo>
    <record id="view_ipfarm_penanaman_tree" model="ir.ui.view">
        <field name="name">ipfarm.penanaman.tree</field>
        <field name="model">ipfarm.penanaman</field>
        <field name="arch" type="xml">
            <tree string="Penanaman Bibit" create="1" delete="0">
                <field name="tanggal_penanaman"/>
                <field name="name"/>
                <field name="bibit_id"/>
                <field name="jumlah_batch"/>
                <field name="jumlah_bibit"/>
                <field name="ruangan_id"/>
                <field name="pegawai_id"/>
            </tree>
        </field>
    </record>
    <record id="view_ipfarm_penanaman_form" model="ir.ui.view">
        <field name="name">ipfarm.penanaman.form</field>
        <field name="model">ipfarm.penanaman</field>
        <field name="arch" type="xml">
            <form string="Input Penanaman Bibit" delete="0">
                <header>
                    <button name="action_show_success" type="object" string="Tampilkan Notifikasi" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tanggal_penanaman" required="1"/>
                            <field name="bibit_id" required="1"/>
                            <field name="ruangan_id" required="1"/>
                        </group>
                        <group>
                            <field name="jumlah_batch" required="1"/>
                            <field name="jumlah_bibit" required="1"/>
                            <field name="pegawai_id" required="1"/>
                            <field name="batch_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Batch Dibuat">
                            <field name="batch_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="name"/>
                                    <field name="tanggal_tanam"/>
                                    <field name="jumlah_bibit"/>
                                    <field name="ruangan_id"/>
                                    <field name="estimasi_panen"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Catatan">
                            <field name="catatan"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_ipfarm_penanaman_search" model="ir.ui.view">
        <field name="name">ipfarm.penanaman.search</field>
        <field name="model">ipfarm.penanaman</field>
        <field name="arch" type="xml">
            <search string="Cari Penanaman">
                <field name="name"/>
                <field name="bibit_id"/>
                <field name="ruangan_id"/>
                <field name="pegawai_id"/>
                <field name="tanggal_penanaman"/>
                <filter name="group_ruangan" string="Ruangan" context="{'group_by': 'ruangan_id'}"/>
                <filter name="group_bibit" string="Bibit" context="{'group_by': 'bibit_id'}"/>
                <filter name="group_tanggal" string="Tanggal" context="{'group_by': 'tanggal_penanaman'}"/>
            </search>
        </field>
    </record>
    <record id="action_ipfarm_penanaman" model="ir.actions.act_window">
        <field name="name">Penanaman Bibit</field>
        <field name="res_model">ipfarm.penanaman</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="search_view_id" ref="view_ipfarm_penanaman_search"/>
    </record>
    <record id="view_ipfarm_penanaman_graph" model="ir.ui.view">
        <field name="name">ipfarm.penanaman.graph</field>
        <field name="model">ipfarm.penanaman</field>
        <field name="arch" type="xml">
            <graph string="Grafik Penanaman" type="bar">
                <field name="bibit_id"/>
                <field name="jumlah_bibit" type="measure"/>
                <field name="jumlah_batch" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_ipfarm_penanaman_pivot" model="ir.ui.view">
        <field name="name">ipfarm.penanaman.pivot</field>
        <field name="model">ipfarm.penanaman</field>
        <field name="arch" type="xml">
            <pivot string="Pivot Penanaman">
                <field name="bibit_id" type="row"/>
                <field name="ruangan_id" type="col"/>
                <field name="jumlah_bibit" type="measure"/>
                <field name="jumlah_batch" type="measure"/>
            </pivot>
        </field>
    </record>
</odoo>
