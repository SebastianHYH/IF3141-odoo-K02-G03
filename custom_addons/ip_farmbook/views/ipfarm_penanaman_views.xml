<odoo>
    <record id="view_ipfarm_penanaman_tree" model="ir.ui.view">
        <field name="name">ipfarm.penanaman.tree</field>
        <field name="model">ipfarm.penanaman</field>
        <field name="arch" type="xml">
            <tree string="Penanaman Bibit" create="1" delete="0">
                <field name="tanggal_penanaman"/>
                <field name="name"/>
                <field name="pegawai_id"/>
                <field name="batch_count" string="Jumlah Batch"/>
            </tree>
        </field>
    </record>

    <record id="view_ipfarm_penanaman_form" model="ir.ui.view">
        <field name="name">ipfarm.penanaman.form</field>
        <field name="model">ipfarm.penanaman</field>
        <field name="arch" type="xml">
            <form string="Input Penanaman Bibit" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tanggal_penanaman" required="1"/>
                        </group>
                        <group>
                            <field name="pegawai_id" required="1"/>
                            <field name="batch_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Batch">
                            <field name="batch_ids">
                                <tree>
                                    <field name="name" string="Nama Batch"/>
                                    <field name="bibit_id"/>
                                    <field name="jumlah_bibit"/>
                                    <field name="ruangan_id"/>
                                    <field name="estimasi_panen"/>
                                    <field name="state" widget="badge" decoration-success="state == 'aktif'" decoration-muted="state == 'selesai'"/>
                                    <control>
                                        <create string="Tambah Batch"/>
                                    </control>
                                </tree>
                            </field>
                        </page>
                        <page string="Catatan">
                            <field name="catatan"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ipfarm_penanaman_search" model="ir.ui.view">
        <field name="name">ipfarm.penanaman.search</field>
        <field name="model">ipfarm.penanaman</field>
        <field name="arch" type="xml">
            <search string="Cari Penanaman">
                <field name="name"/>
                <field name="pegawai_id"/>
                <field name="tanggal_penanaman"/>
                <filter name="group_tanggal" string="Tanggal" context="{'group_by': 'tanggal_penanaman'}"/>
                <filter name="group_pegawai" string="Pegawai" context="{'group_by': 'pegawai_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_ipfarm_penanaman" model="ir.actions.act_window">
        <field name="name">Penanaman Bibit</field>
        <field name="res_model">ipfarm.penanaman</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_ipfarm_penanaman_search"/>
    </record>
</odoo>
