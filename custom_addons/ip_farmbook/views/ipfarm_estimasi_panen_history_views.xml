<odoo>
    <record id="view_ipfarm_batch_estimasi_form" model="ir.ui.view">
        <field name="name">ipfarm.batch.estimasi.form</field>
        <field name="model">ipfarm.batch</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Update Estimasi Panen">
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Nama Batch" readonly="1"/>
                            <field name="bibit_id" readonly="1"/>
                            <field name="ruangan_id" readonly="1"/>
                            <field name="tanggal_tanam" readonly="1"/>
                        </group>
                        <group>
                            <field name="estimasi_panen"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
