<odoo>
    <record id="view_ipfarm_panen_tree" model="ir.ui.view">
        <field name="name">ipfarm.panen.tree</field>
        <field name="model">ipfarm.panen</field>
        <field name="arch" type="xml">
            <tree string="Hasil Panen" create="1" edit="0" delete="0">
                <field name="tanggal_panen"/>
                <field name="name"/>
                <field name="batch_id"/>
                <field name="penanaman_id"/>
                <field name="produk_id"/>
                <field name="jumlah" sum="Total Panen"/>
                <field name="uom_id"/>
                <field name="pegawai_id"/>
                <field name="histori_stok_id"/>
            </tree>
        </field>
    </record>

    <record id="view_ipfarm_panen_form" model="ir.ui.view">
        <field name="name">ipfarm.panen.form</field>
        <field name="model">ipfarm.panen</field>
        <field name="arch" type="xml">
            <form string="Input Hasil Panen" delete="0">
                <header>
                    <button name="action_lihat_stok_produk" type="object" string="Lihat Stok Produk" class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="batch_id" required="1"/>
                            <field name="penanaman_id"/>
                            <field name="tanggal_panen" required="1"/>
                            <field name="produk_id" required="1"/>
                        </group>
                        <group>
                            <field name="jumlah" required="1"/>
                            <field name="uom_id" required="1"/>
                            <field name="pegawai_id" required="1"/>
                            <field name="histori_stok_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Catatan">
                            <field name="catatan" placeholder="Catatan tambahan hasil panen..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ipfarm_panen_search" model="ir.ui.view">
        <field name="name">ipfarm.panen.search</field>
        <field name="model">ipfarm.panen</field>
        <field name="arch" type="xml">
            <search string="Cari Hasil Panen">
                <field name="name"/>
                <field name="batch_id"/>
                <field name="produk_id"/>
                <field name="pegawai_id"/>
                <field name="tanggal_panen"/>
                <filter name="group_produk" string="Produk" context="{'group_by': 'produk_id'}"/>
                <filter name="group_batch" string="Batch" context="{'group_by': 'batch_id'}"/>
                <filter name="group_tanggal" string="Tanggal Panen" context="{'group_by': 'tanggal_panen'}"/>
            </search>
        </field>
    </record>

    <record id="view_ipfarm_panen_graph" model="ir.ui.view">
        <field name="name">ipfarm.panen.graph</field>
        <field name="model">ipfarm.panen</field>
        <field name="arch" type="xml">
            <graph string="Grafik Hasil Panen" type="bar">
                <field name="produk_id"/>
                <field name="jumlah" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_ipfarm_panen_pivot" model="ir.ui.view">
        <field name="name">ipfarm.panen.pivot</field>
        <field name="model">ipfarm.panen</field>
        <field name="arch" type="xml">
            <pivot string="Pivot Hasil Panen">
                <field name="produk_id" type="row"/>
                <field name="tanggal_panen" type="col"/>
                <field name="jumlah" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_ipfarm_panen" model="ir.actions.act_window">
        <field name="name">Hasil Panen</field>
        <field name="res_model">ipfarm.panen</field>
        <field name="view_mode">tree,form,graph,pivot</field>
        <field name="search_view_id" ref="view_ipfarm_panen_search"/>
    </record>
</odoo>
